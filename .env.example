# Copy to .env.local (local) or .env (server) and fill in. Never commit real values.

# ---- URLs (no hardcoded hosts in code — change these per environment) ----
# Public address of the site: canonical URLs, sitemap, robots, links, PayU return URL.
# NEXT_PUBLIC_ = also used in browser code and baked in at build: rebuild after changing.
#   local:  http://localhost:3000
#   test:   https://shop99.cybertricksmedia.in
#   live:   https://www.shop99.co.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the server calls this app's own /api while rendering pages.
# Use the app's internal address (fast, skips the public domain):
#   local and server: http://localhost:<port the app runs on>, e.g. http://localhost:3000
# Optional — defaults to NEXT_PUBLIC_SITE_URL.
FRONTEND_URL=http://localhost:3000

# Optional: sitemap build overrides (default: NEXT_PUBLIC_SITE_URL).
# SITEMAP_SITE_URL=
# SITEMAP_API_URL=

# ---- Database ----
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Auth ----
JWT_SECRET=

# ---- PayU ----
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ---- SMS (Fast2SMS) ----
FAST2SMS_API_KEY=
FAST2SMS_ENTITY_ID=
FAST2SMS_NUMBERS_WITH_91=
FAST2SMS_ORDER_CONFIRMED_F2S_MESSAGE_ID=
FAST2SMS_ORDER_DELIVERED_F2S_MESSAGE_ID=
FAST2SMS_ORDER_STATUS_SMS_ENABLED=
FAST2SMS_SENDER_ID=
FAST2SMS_SMS_ROUTE=
